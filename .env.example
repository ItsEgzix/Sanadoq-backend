# Port the API listens on. Unset: 5050.
PORT=5050

# Required — the app refuses to boot without it. A postgres:// URL; the pg
# driver adapter cannot use prisma+postgres:// URLs. Neon: the pooled
# connection string from the dashboard.
DATABASE_URL="postgres://user:password@host/neondb?sslmode=require"

# Postgres schema the tables live in. Unset: public. Lets a test or
# verification run use an isolated schema of the same database.
# DATABASE_SCHEMA=sanadoq_verify

# Required — signs access and refresh tokens (HS256). 32+ characters. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
JWT_SECRET=

# Browser origin allowed by CORS (the Next.js frontend). Credentials are
# allowed for exactly this origin, so the refresh cookie works.
# Unset: http://localhost:5000.
CORS_ORIGIN=http://localhost:5000

# How many proxies sit in front of the API, so the login throttle keys on
# the real client IP. Unset: 0 (the socket address is the client).
# TRUST_PROXY_HOPS=1

# Only for `npm run migrate:legacy-eradat`: the database that still holds the
# old Member-shaped demo data (e.g. the local `npx prisma dev` server).
# LEGACY_DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"


